Output demo.gif
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 19
Set Width 1100
Set Height 680
Set Padding 28
Set Margin 0
Set Theme "Dracula"
Set TypingSpeed 28ms
Set CursorBlink false

Type "system-ledger scan"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger build"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger summary"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger path listProducts product"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger doctor"
Enter
Sleep 5s
