Output demo.gif
Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 18
Set Width 1040
Set Height 500
Set Padding 20
Set Margin 0
Set Theme "Dracula"
Set TypingSpeed 22ms
Set CursorBlink false

Type "system-ledger scan"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger build"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger summary"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger path listProducts product"
Enter
Sleep 3s
Ctrl+L

Type "system-ledger doctor"
Enter
Sleep 7s
